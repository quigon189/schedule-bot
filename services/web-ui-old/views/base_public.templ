package views

templ BasePublic(title string, content templ.Component) {
<!DOCTYPE html>
<html lang="ru">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{ title }</title>
	<!-- Bootstrap + Icons -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<!-- HTMX -->
	<script src="https://unpkg.com/htmx.org@2.0.0"></script>
	<!-- Небольшой кастомный JS для запоминания логина -->
	<script>
		// Сохраняет логин в localStorage при отправке формы
		function rememberLogin(username) {
			if (username) localStorage.setItem('saved_login', username);
		}
		// Загружает сохранённый логин на страницу
		function loadSavedLogin() {
			const saved = localStorage.getItem('saved_login');
			if (saved) {
				const input = document.getElementById('username');
				if (input) input.value = saved;
			}
		}
	</script>
	<style>
		body {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0;
			padding: 1rem;
		}

		.public-container {
			width: 100%;
			max-width: 500px;
			/* максимальная ширина карточки */
		}
	</style>
</head>

<body>
	<main class="public-container">
		@content
	</main>

	<!-- Подгрузка bootstrap JS (необходима для некоторых компонентов) -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
}
