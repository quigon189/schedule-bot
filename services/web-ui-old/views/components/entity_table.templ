package components

import (
	"fmt"
	"strconv"
	"web-ui/internal/models"
)

// EntityTable – универсальная таблица с пагинацией
templ EntityTable(cfg models.TableConfig, data *models.PaginatedTableData, filters templ.Component) {
	<div id={ cfg.ID + "-container" }>
		<div class="card mb-3">
			<div class="card-header">
				<h5 class="mb-0">{ cfg.Title }</h5>
			</div>
			<div class="card-body">
				<!-- Блок фильтров (передаётся извне) -->
				@filters
				<!-- Таблица -->
				<div class="table-responsive">
					<table class="table table-striped table-hover align-middle">
						<thead>
							<tr>
								for _, col := range cfg.Columns {
									<th style={ "width: " + col.Width }>{ col.Title }</th>
								}
								if cfg.HasActions {
									<th style="width: 80px">Действия</th>
								}
							</tr>
						</thead>
						<tbody>
							if len(data.Rows) == 0 {
								<tr>
									<td colspan={ len(cfg.Columns) + boolToInt(cfg.HasActions) } class="text-center text-muted">
										Нет данных
									</td>
								</tr>
							} else {
								for _, row := range data.Rows {
									<tr id={ fmt.Sprintf("%s-row-%v", cfg.ID, row["id"]) }>
										for _, col := range cfg.Columns {
											<td>{ renderValue(row[col.Key]) }</td>
										}
										if cfg.HasActions {
											<td>
												<div class="btn-group btn-group-sm">
													<button
														class="btn btn-outline-primary"
														hx-get={ fmt.Sprintf(cfg.EditURL, row["id"]) }
														hx-target="#modalContent"
														data-bs-toggle="modal"
														data-bs-target="#entityModal"
													>
														<i class="bi bi-pencil"></i>
													</button>
													<button
														class="btn btn-outline-danger"
														hx-delete={ fmt.Sprintf(cfg.DeleteURL, row["id"]) }
														hx-confirm="Удалить запись?"
														hx-target={ fmt.Sprintf("#%s-row-%v", cfg.ID, row["id"]) }
														hx-swap="outerHTML"
													>
														<i class="bi bi-trash"></i>
													</button>
												</div>
											</td>
										}
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
				<!-- Пагинация -->
				@Pagination(cfg.ID, data)
			</div>
		</div>
	</div>
}

// Pagination – элементы пагинации
templ Pagination(tableID string, data *models.PaginatedTableData) {
	<nav>
		<ul class="pagination justify-content-center mt-3">
			if data.Page > 1 {
				<li class="page-item">
					<a
						class="page-link"
						href="#"
						hx-get={ pageURL(tableID, data.Page-1, data.PerPage) }
						hx-target={ "#" + tableID + "-container" }
					>
						Назад
					</a>
				</li>
			} else {
				<li class="page-item disabled"><a class="page-link">Назад</a></li>
			}
			for i := 1; i <= data.TotalPages; i++ {
				if i == data.Page {
					<li class="page-item active"><a class="page-link">{ i }</a></li>
				} else {
					<li class="page-item">
						<a
							class="page-link"
							href="#"
							hx-get={ pageURL(tableID, i, data.PerPage) }
							hx-target={ "#" + tableID + "-container" }
						>
							{ i }
						</a>
					</li>
				}
			}
			if data.Page < data.TotalPages {
				<li class="page-item">
					<a
						class="page-link"
						href="#"
						hx-get={ pageURL(tableID, data.Page+1, data.PerPage) }
						hx-target={ "#" + tableID + "-container" }
					>
						Вперёд
					</a>
				</li>
			} else {
				<li class="page-item disabled"><a class="page-link">Вперёд</a></li>
			}
		</ul>
	</nav>
}

// Вспомогательные функции
func pageURL(tableID string, page, perPage int) string {
	// Предполагается, что маршрут вида /admin/entities/{entity}/table?page=...&per_page=...
	// Вызывающий компонент фильтров должен добавлять свои параметры через data-attributes или hx-vals
	return fmt.Sprintf("?page=%d&per_page=%d", page, perPage)
}

func renderValue(v interface{}) string {
	switch val := v.(type) {
	case string:
		return val
	case int:
		return strconv.Itoa(val)
	case nil:
		return "—"
	default:
		return fmt.Sprintf("%v", val)
	}
}

func boolToInt(b bool) int {
	if b {
		return 1
	}
	return 0
}

// BaseFilterForm – базовая форма фильтров, расширяемая для каждой сущности
templ BaseFilterForm(tableID string, extraFields templ.Component) {
	<form
		hx-get="."
		hx-target={ "#" + tableID + "-container" }
		hx-push-url="true"
		hx-trigger="submit, change from:select, change from:[name='per_page']"
	>
		<div class="row g-3 align-items-end">
			@extraFields
			<div class="col-auto">
				<label class="visually-hidden">Показывать по</label>
				<select name="per_page" class="form-select form-select-sm">
					<option value="10">10</option>
					<option value="20">20</option>
					<option value="50">50</option>
					<option value="100">100</option>
				</select>
			</div>
			<div class="col-auto">
				<button type="submit" class="btn btn-sm btn-secondary">Применить</button>
			</div>
		</div>
	</form>
}
