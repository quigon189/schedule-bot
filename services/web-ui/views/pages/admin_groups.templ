package pages

import (
	"web-ui/internal/models"
	"web-ui/views"
	"web-ui/views/components"
)

templ AdminGroupsPage(csrf string, currentUser *models.User, groups []models.Group) {
	@views.BasePrivate("Управление группами", csrf, components.AdminSidebar(currentUser, "/admin/groups"), AdminGroupsContent())
}

templ AdminGroupsContent() {
	<div class="container-fluid">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="h3">Группы</h1>
			<div>
				<button class="btn btn-primary me-2" 
						hx-get="/admin/groups/new" 
						hx-target="#modalContent"
						data-bs-toggle="modal" 
						data-bs-target="#groupModal">
					<i class="bi bi-plus-circle"></i> Создать группу
				</button>
				<button class="btn btn-secondary" 
						hx-get="/admin/groups/upload-form"
						hx-target="#modalContent"
						data-bs-toggle="modal"
						data-bs-target="#groupModal">
					<i class="bi bi-upload"></i> Загрузить из Excel
				</button>
			</div>
		</div>

		<!-- Контейнер для списка групп (обновляется через hx-get) -->
		<div hx-get="/admin/groups/list" hx-trigger="load, groupListChanged from:body" hx-swap="innerHTML">
			<div class="text-center">Загрузка...</div>
		</div>
	</div>

	<!-- Модальное окно для форм (создание/загрузка) -->
	<div class="modal fade" id="groupModal" tabindex="-1" data-bs-backdrop="static">
		<div class="modal-dialog">
			<div class="modal-content" id="modalContent">
				<!-- сюда загрузится форма -->
			</div>
		</div>
	</div>

	}
