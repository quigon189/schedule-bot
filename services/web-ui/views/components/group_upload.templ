package components

templ GroupUploadForm() {
	<form hx-post="/admin/groups/upload" hx-encoding="multipart/form-data" hx-target="#uploadError" hx-swap="innerHTML">
		<div class="modal-header">
			<h5 class="modal-title">Загрузка групп из Excel</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
		</div>
		<div class="modal-body">
			<div id="uploadError" class="mb-3"></div>
			<div class="mb-3">
				<label class="form-label">Excel-файл (.xlsx)</label>
				<input type="file" name="file" class="form-control" accept=".xlsx" required>
				<div class="form-text">Файл должен соответствовать шаблону.</div>
			</div>
			<div class="mb-3">
				<a href="/admin/groups/template" hx-boost="false" class="btn btn-info">
					<i class="bi bi-download"></i> Скачать шаблон
				</a>
			</div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
			<button type="submit" class="btn btn-primary">Загрузить</button>
		</div>
	</form>
}
