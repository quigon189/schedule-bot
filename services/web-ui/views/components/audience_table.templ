package components

import "web-ui/internal/models"
import "fmt"

templ AudiencesTable(audiences []models.Audience, filterNumber, filterName string) {
	<div id="audiences-table-container">
		<div class="card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h5 class="mb-0">Список аудиторий</h5>
				<div>
					<button class="btn btn-sm btn-primary me-2" 
							hx-get="/admin/audiences/new" 
							hx-target="#modalContent"
							data-bs-toggle="modal" 
							data-bs-target="#audienceModal">
						<i class="bi bi-plus-circle"></i> Добавить
					</button>
					<button class="btn btn-sm btn-secondary" 
							hx-get="/admin/audiences/upload-form"
							hx-target="#modalContent"
							data-bs-toggle="modal"
							data-bs-target="#audienceModal">
						<i class="bi bi-upload"></i> Загрузить Excel
					</button>
				</div>
			</div>
			<div class="card-body">
				<!-- Фильтры -->
				<form hx-get="/admin/audiences/table" 
					  hx-target="#audiences-table-container" 
					  hx-push-url="true"
					  class="row g-3 mb-3">
					<div class="col-md-5">
						<input type="text" name="number" class="form-control" placeholder="Номер аудитории" 
							   value={ filterNumber }>
					</div>
					<div class="col-md-5">
						<input type="text" name="name" class="form-control" placeholder="Название" 
							   value={ filterName }>
					</div>
					<div class="col-md-2">
						<button type="submit" class="btn btn-secondary w-100">Фильтр</button>
					</div>
				</form>

				<!-- Таблица -->
				<div class="table-responsive">
					<table class="table table-striped table-hover align-middle">
						<thead>
							<tr>
								<th>ID</th>
								<th>Название</th>
								<th>Номер</th>
								<th style="width: 100px">Действия</th>
							</tr>
						</thead>
						<tbody>
							if len(audiences) == 0 {
								<tr>
									<td colspan="4" class="text-center text-muted">Нет аудиторий</td>
								</tr>
							} else {
								for _, a := range audiences {
									<tr id={ fmt.Sprintf("audience-%d", a.ID) }>
										<td>{ a.ID }</td>
										<td>{ a.Name }</td>
										<td>{ a.Number }</td>
										<td>
											<div class="btn-group btn-group-sm">
												<button class="btn btn-outline-primary" 
														hx-get={ fmt.Sprintf("/admin/audiences/%d/edit", a.ID) }
														hx-target="#modalContent"
														data-bs-toggle="modal"
														data-bs-target="#audienceModal">
													<i class="bi bi-pencil"></i>
												</button>
												<button class="btn btn-outline-danger" 
														hx-delete={ fmt.Sprintf("/admin/audiences/%d", a.ID) }
														hx-confirm="Удалить аудиторию?"
														hx-target={ fmt.Sprintf("#audience-%d", a.ID) }
														hx-swap="outerHTML">
													<i class="bi bi-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
}
