package views

import (
	"fmt"

	"web-ui/internal/middlewares"
    "web-ui/internal/models"
    "web-ui/views/components"
)

templ BasePrivate(title string, csrfToken string, navbar, content templ.Component) {
    <!DOCTYPE html>
    <html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{ title }</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <script src="https://unpkg.com/htmx.org@2.0.0"></script>
    </head>
    <body
	hx-boost="true"
	hx-headers={fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken)}
	>
        <!-- Рендерим navbar в зависимости от ролей -->
        @navbar

        <main class="container mt-4">
            @content
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
}
