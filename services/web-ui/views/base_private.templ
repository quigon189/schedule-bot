package views

templ BasePrivate(title string, csrfToken string, sidebar, content templ.Component) {
    <!DOCTYPE html>
    <html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="csrf-token" content={ csrfToken }>
        <title>{ title }</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/static/css/main.css">
        <script src="https://unpkg.com/htmx.org@2.0.0"></script>
        <script src="/static/js/main.js" defer></script>
    </head>
    <body hx-boost="true">
        <!-- Боковое меню -->
        @sidebar
        <!-- Основной контент -->
        <div class="main-content" id="mainContent">
			<div id="alerts-container"
				 hx-get="/alerts"
				 hx-trigger="load, every 10s"
				 hx-swap="beforeend">
			</div>

            <!-- Основное содержимое страницы -->
            @content
        </div>
        
		<script>
			// Следим за тем, видит ли пользователь страницу
			document.addEventListener('visibilitychange', function() {
				const watcher = document.getElementById('alerts-container');
				
				if (document.hidden) {
					// Пользователь ушел — полностью отключаем опрос (ставим несуществующее событие)
					watcher.setAttribute('hx-trigger', 'unset');
				} else {
					// Пользователь вернулся — включаем быстрый опрос и сразу делаем один запрос
					watcher.setAttribute('hx-trigger', 'every 10s');
					htmx.trigger(watcher, 'confirmed'); 
				}
				htmx.process(watcher);
			});
		</script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
}
